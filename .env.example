# =====================================================================
#  AttSite Bot — configuração
#  Copie este arquivo para ".env" (o iniciar.bat faz isso sozinho)
# =====================================================================

# ---------- OBRIGATÓRIO ----------
# Token do seu bot. No Telegram, fale com @BotFather -> /newbot -> copie o token.
TELEGRAM_BOT_TOKEN=cole_o_token_aqui

# ---------- ACESSO ----------
# IDs do Telegram que podem usar o bot, separados por vírgula (ex: 123456789,987654321).
# Deixe VAZIO: o primeiro usuário que mandar /start vira o dono automaticamente
# e pode liberar outras pessoas com /allow <id>.
ALLOWED_USERS=

# ---------- MONITORAMENTO ----------
# Intervalo padrão do /add quando você não informa (em segundos)
DEFAULT_INTERVAL=60
# Menor intervalo permitido (em segundos). Não abuse: sites podem bloquear.
MIN_INTERVAL=10
# Quantos sites checar ao mesmo tempo
MAX_CONCURRENCY=5
# Tempo máximo esperando um site responder (segundos)
REQUEST_TIMEOUT=30
# Avisa no Telegram depois de quantas falhas seguidas
ERROR_ALERT_AFTER=3
MAX_WATCHES_PER_CHAT=100
# Fuso usado no horário dos avisos
TIMEZONE=America/Sao_Paulo

# ---------- USER-AGENT ----------
# Vazio = finge ser um Chrome comum.
USER_AGENT=
# A SEC (sec.gov / EDGAR) EXIGE que robôs se identifiquem com nome + e-mail,
# senão responde 403. Preencha se for monitorar a SEC:
# SEC_USER_AGENT=Fulano da Silva fulano@gmail.com
SEC_USER_AGENT=

# ---------- AVANÇADO ----------
# Onde fica o banco e o log (padrão: pasta data/)
DB_PATH=
LOG_FILE=
LOG_LEVEL=INFO
